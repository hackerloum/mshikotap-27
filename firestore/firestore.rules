rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return signedIn() && userDoc().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      // Profiles are created and rewarded by server routes (Admin SDK).
      // Players may only edit cosmetic fields on their own profile.
      allow create: if false;
      allow update: if (isSelf(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'photoURL', 'updatedAt'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // All writes below go through server routes (Admin SDK bypasses rules).
    match /tasks/{taskId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /taskSubmissions/{submissionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn() && (resource.data.advertiserId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /earningsDaily/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if false;
    }

    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
