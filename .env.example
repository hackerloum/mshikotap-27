NEXT_PUBLIC_APP_NAME=MshikoTap
NEXT_PUBLIC_APP_URL=https://mshikotap.co.tz

NEXT_PUBLIC_FIREBASE_API_KEY=PASTE_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=PASTE_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=PASTE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=PASTE_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PASTE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=PASTE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=PASTE_MEASUREMENT_ID_OPTIONAL
NEXT_PUBLIC_FIREBASE_VAPID_KEY=PASTE_VAPID_KEY_OPTIONAL

FIREBASE_ADMIN_PROJECT_ID=PASTE_PROJECT_ID
FIREBASE_ADMIN_CLIENT_EMAIL=PASTE_SERVICE_ACCOUNT_EMAIL
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: random string used to hash IP and device ids for anti-cheat
IP_HASH_SALT=

# Snippe payments (https://snippe.sh): API key and webhook secret from the Snippe dashboard
SNIPPE_API_KEY=snp_PASTE_KEY
SNIPPE_WEBHOOK_SECRET=whsec_PASTE_SECRET

# AI manager: Vercel AI Gateway key (https://vercel.com/ai-gateway). AI_MODEL is optional.
AI_GATEWAY_API_KEY=PASTE_GATEWAY_KEY
AI_MODEL=anthropic/claude-sonnet-5.5

# Protects the daily autopilot cron. Any long random string. Vercel sends it automatically.
CRON_SECRET=
