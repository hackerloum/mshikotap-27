# =============================================================================
# MshikoTap — Environment Variables (Vercel + Firebase)
# =============================================================================
# Copy to .env.local for local use:
#   cp .env.example .env.local
#
# On Vercel: Project → Settings → Environment Variables
# Add each key for Production, Preview, and Development as noted.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_NAME=MshikoTap
# Production: https://mshikotap.co.tz | Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://mshikotap.co.tz
# true = local/demo fixtures; false = use live Firebase (requires keys below)
NEXT_PUBLIC_DEMO_MODE=true

# --- Firebase Web Client (Project settings → Your apps → Web app config) ---
# These are NEXT_PUBLIC_* so they ship to the browser — that is expected for Firebase Web SDK.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional FCM web push
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin (server only — NEVER use NEXT_PUBLIC_) ---
# Firebase Console → Project settings → Service accounts → Generate new private key
# Paste the JSON fields below. On Vercel, put the private key as one line with \n escapes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Optional future integrations ---
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
AI_GATEWAY_API_KEY=
